# scalert MC Earthquake Notifier — Configuration
# Copy this file to scalert_mceqnotifier.cfg and edit with your settings.
# Place it next to scalert_mceqnotifier.py

[smtp]
# SMTP server settings (Gmail example shown)
server = smtp.gmail.com
port   = 587
ssl    = false
tls    = true

# SMTP credentials (for Gmail, use an App Password — not your regular password)
# See: https://support.google.com/accounts/answer/185833
user = your-email@gmail.com
pw   = your-app-password

# Sender address (usually same as user)
from = your-email@gmail.com

# Recipient list — comma-separated (used when no region-specific recipients match)
to = recipient1@example.com,recipient2@example.com

# Connection timeout in seconds (prevents hanging when firewall/VPN blocks SMTP)
timeout = 30

[filter]
# Minimum magnitude to send a notification (events below this are silently ignored)
min_magnitude = 4.0

# Maximum magnitude (leave empty for no upper limit — useful for testing)
# max_magnitude =

# Minimum number of phase arrivals to trigger notification (0 = disabled)
# Increase this to suppress poorly-constrained events (e.g. 10 or 15)
min_arrivals = 0

# Set to true to only notify on NEW events (skip updates)
new_events_only = true

[seiscomp]
# Direct database connection for scxmldump (recommended — avoids messaging dependency)
# Adjust user, password, host, and database name to match your SeisComP setup
database = mysql://sysop:sysop@localhost/seiscomp

[map]
width      = 512
height     = 512
radius_min = 5
radius_max = 40
auto_radius = true

[content]
# scbulletin bulletin format: autoloc1 | autoloc3 | autoloc3extra | fdsnws
bulletin_format   = autoloc3
bulletin_enhanced = true

# KML event-location file attachment
attach_kml = true

# Include Google Maps link in plain-text body
include_maps_link = true

# Footer text at the bottom of every email
footer = Automated Earthquake Notification

# Travel-time curve PNG attachment (ObsPy TauPy IASP91)
generate_travel_curves = true

# Waveform plot PNG attachment — requires FDSNWS dataselect running locally
generate_waveforms = false
fdsnws_url         = http://localhost:8081
waveform_pre_secs  = 30
waveform_post_secs = 300
waveform_max_stations = 8

# Maximum rows in the phase arrivals table
max_arrivals_table = 30

[cities]
# Path to cities.xml — leave empty to auto-detect from $SEISCOMP_ROOT/share/cities.xml
xml =

# Show cities within this radius (km). Falls back to nearest max_count if too
# few cities are found within the radius (e.g. ocean events).
radius_km = 1000

# Maximum number of cities to show in the distance table
max_count = 10

# Ignore non-capital cities with population below this threshold
min_population = 300000

[cooldown]
# Prevent duplicate notifications for the same event within a time window.
# Useful when scalert fires rapid updates as the location/magnitude refines.
enabled  = false
seconds  = 300
# Directory for cooldown state files (leave empty for /tmp/scalert_mceqnotifier_cooldown)
# state_dir =

[logging]
# Log verbosity: debug | info | warning | error
level = info
# Directory for per-event log files (one file per run: mceqnotifier_<eventID>_<timestamp>.log)
# Leave empty to disable file logging (output goes to stderr / scalert.log only)
# log_dir = /home/sysop/.seiscomp/log/mceqnotifier

# ---------------------------------------------------------------------------
# REGION-BASED FILTERING (optional)
# ---------------------------------------------------------------------------
# Define [region:NAME] sections to set up geographic filtering with per-region
# overrides for magnitude, arrivals, recipients, etc.
#
# When regions are defined:
#   - Each event is checked against all enabled regions
#   - A region matches if the epicenter falls within its bounding box
#   - Each matching region can have its own thresholds and recipient list
#   - An event can match MULTIPLE regions (each gets its own notification)
#   - Events outside all regions are silently dropped
#
# When NO regions are defined:
#   - All events use the global [filter] settings (backward-compatible)
#
# Per-region settings override the global [filter] equivalents.
# If a per-region setting is omitted, the global value is used as fallback.
#
# PTWC Tsunami Alert Levels (automatically computed for shallow events):
#   WARNING     — M >= 7.6, depth < 100 km (dangerous flooding, evacuate)
#   ADVISORY    — M 7.0-7.5, depth < 100 km (strong currents, stay off beaches)
#   WATCH       — M 6.5-6.9, depth < 100 km (tsunami possible, be prepared)
#   INFORMATION — M < 6.5 or depth >= 100 km (no threat expected)
#
# Event Retraction:
#   If an event is set to type "not existing" by an analyst, a retraction
#   email is automatically sent to notify recipients the alert was a false alarm.
#
# Example regions:
#
# [region:Turkey]
# enabled = true
# lat_min = 35.0
# lat_max = 43.0
# lon_min = 25.0
# lon_max = 45.0
# min_magnitude = 3.0
# min_arrivals = 8
# # Per-region recipients (optional — omit to use global [smtp] to=)
# to = turkey-team@example.com,ops@example.com
#
# [region:Greece]
# enabled = true
# lat_min = 34.0
# lat_max = 42.0
# lon_min = 19.0
# lon_max = 30.0
# min_magnitude = 3.5
# min_arrivals = 5
# new_events_only = false
# to = greece-team@example.com
#
# [region:Global-Large]
# # Catch large events worldwide (use wide bounds)
# enabled = true
# lat_min = -90.0
# lat_max = 90.0
# lon_min = -180.0
# lon_max = 180.0
# min_magnitude = 6.0
# min_arrivals = 20
# to = management@example.com
